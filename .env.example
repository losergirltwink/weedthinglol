# Copy to .env.local for local development. Everything is optional locally:
# with no .env.local the app uses an on-disk PGlite database and localhost.
# Production / preview values live in Vercel project settings (docs/deploy.md).

# postgres://… (Neon) or pglite://<dir>. Default: pglite://.data/pglite
DATABASE_URL=

# Session signing secret, ≥32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public origin of the site; also the passkey relying-party origin.
# Default: http://localhost:3000 (Vercel previews fall back to VERCEL_URL).
BETTER_AUTH_URL=

# GitHub OAuth app (use a separate dev app with callback
# http://localhost:3000/api/auth/callback/github for local sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The only account allowed to sign in: your numeric GitHub id.
# Find it with `gh api user --jq .id` or https://api.github.com/users/<username>
OWNER_GITHUB_ID=
